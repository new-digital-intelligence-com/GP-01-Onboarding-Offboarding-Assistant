# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Anthropic API key from https://console.anthropic.com/settings/keys — the console calls the
# Claude API with the GP-01 skill as its system prompt. Server-side only; never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Defaults to the model named in src/app/api/run/route.ts.
CLAUDE_MODEL=

# Zapier MCP endpoint carrying Google Workspace Admin, BambooHR, Gmail (as peopleops@),
# Slack and Google Sheets. This is the same endpoint the skill uses in chat — the console
# holds no Google, Slack or BambooHR credentials of its own.
#
# Anyone who can reach this URL can act on those connected accounts. Keep the deployment
# behind authentication and never commit the value.
ZAPIER_MCP_URL=
ZAPIER_MCP_TOKEN=
